<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Siphon" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#07080D</item>
        <item name="android:windowBackground">#07080D</item>
        <item name="android:colorAccent">#9B5CFF</item>

        <!-- Android 12+ system splash: dark field + slightly smaller clean Siphon mark. -->
        <item name="android:windowSplashScreenBackground">#07080D</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/siphon_splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#07080D</item>
        <item name="android:windowSplashScreenAnimationDuration">180</item>
    </style>
</resources>
